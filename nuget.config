<?xml version="1.0" encoding="utf-8"?>
<!--
  Pins where packages come from, for this repo only.

  Without this file, restore uses whatever sources the machine happens to have configured. On a
  developer machine that is usually nuget.org plus one or more private feeds, which NuGet warns about
  under central package management (NU1507): with several sources and no mapping, it cannot tell you
  which feed a package will actually come from, and the answer can differ between two machines
  restoring the same commit.

  Every package this repo references is public and comes from nuget.org, so the mapping is one rule.
  It also closes the dependency-confusion gap the warning is really about: with a private feed in
  scope and no mapping, a package published there under the name of one of ours could be picked up
  ahead of the real one.

  This does not affect publishing. CI adds its own source and pushes to an explicitly named feed
  (.github/workflows/ci.yml), which does not consult this mapping.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
