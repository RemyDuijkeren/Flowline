<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
      <OutputType>Exe</OutputType>
      <ApplicationIcon>../../docs/flowline.ico</ApplicationIcon>
      <InvariantGlobalization>true</InvariantGlobalization>
      <PackAsTool>true</PackAsTool>
      <ToolCommandName>flowline</ToolCommandName>
      <PackageOutputPath>../../artifacts/nupkg</PackageOutputPath>
    </PropertyGroup>

    <PropertyGroup Label="PackageProperties">
      <PackageId>Flowline</PackageId>
      <Description>Flowline is your lightweight, flexible alternative to rigid Power Platform Pipelines.</Description>
      <PackageTags>Dataverse Dynamics PowerApps PowerPlatform Pipeline Deploy CLI</PackageTags>
    </PropertyGroup>

    <ItemGroup>
      <None Include="../../README.md" Pack="true" PackagePath="\" Visible="false" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Include="Templates\WebResources\WebResources.csproj">
        <LogicalName>Flowline.Templates.WebResources.WebResources.csproj</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="Templates\WebResources\package.json">
        <LogicalName>Flowline.Templates.WebResources.package.json</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="Templates\WebResources\rollup.config.mjs">
        <LogicalName>Flowline.Templates.WebResources.rollup.config.mjs</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="Templates\WebResources\tsconfig.json">
        <LogicalName>Flowline.Templates.WebResources.tsconfig.json</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="Templates\WebResources\eslint.config.mjs">
        <LogicalName>Flowline.Templates.WebResources.eslint.config.mjs</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="Templates\WebResources\README.md">
        <LogicalName>Flowline.Templates.WebResources.README.md</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="Templates\WebResources\src\example.ts">
        <LogicalName>Flowline.Templates.WebResources.src.example.ts</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="Templates\WebResources\src\example-js.js">
        <LogicalName>Flowline.Templates.WebResources.src.example-js.js</LogicalName>
      </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="CliWrap" />
      <!-- contentFiles hold two more copies of the 1.75 MB dictionary that lib/ already carries;
           the files EBG actually reads at runtime are copied explicitly below instead. -->
      <PackageReference Include="DLaB.Xrm.EarlyBoundGeneratorV2.Api" ExcludeAssets="contentFiles" GeneratePathProperty="true" />
      <PackageReference Include="Serilog" />
      <PackageReference Include="Serilog.Extensions.Logging" />
      <PackageReference Include="Serilog.Sinks.File" />
      <PackageReference Include="Spectre.Console.Cli" />
      <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
      <PackageReference Include="MinVer" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup Label="EbgRuntimeData">
      <!-- EBG reads these from disk, not from the assembly. NuGet ships only assemblies out of lib/,
           so copy them next to the tool: the dictionary is mandatory (CamelCaser throws without it),
           the alphabets are optional and only affect transliteration of non-Latin option labels.
           EbgGenerator pins both paths absolutely, so the layout here is ours to choose. -->
      <None Include="$(PkgDLaB_Xrm_EarlyBoundGeneratorV2_Api)\lib\net10.0\DLaB.Dictionary.txt"
            CopyToOutputDirectory="PreserveNewest" Visible="false" />
      <None Include="$(PkgDLaB_Xrm_EarlyBoundGeneratorV2_Api)\contentFiles\any\any\DLaB.EarlyBoundGeneratorV2\alphabets\*.json"
            CopyToOutputDirectory="PreserveNewest" Visible="false" Link="alphabets\%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Flowline.Core\Flowline.Core.csproj" />
    </ItemGroup>

</Project>
